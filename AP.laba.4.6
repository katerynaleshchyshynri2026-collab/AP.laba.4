#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

int main()
{
    double S, P;
    int i, k, N;

    cout << "N = "; cin >> N;

    cout << fixed << setprecision(6);

    // 1 спосіб: while
    S = 0;
    i = 1;
    while (i <= N)
    {
        P = 1;
        k = 1;
        while (k <= i)
        {
            P *= (double)k / i;
            k++;
        }
        S += (1 + P) / (i * i);
        i++;
    }
    cout << "while:      " << S << endl;

    // 2 спосіб: do-while
    S = 0;
    i = 1;
    do {
        P = 1;
        k = 1;
        do {
            P *= (double)k / i;
            k++;
        } while (k <= i);
        S += (1 + P) / (i * i);
        i++;
    } while (i <= N);
    cout << "do-while:   " << S << endl;

    // 3 спосіб: for з інкрементом
    S = 0;
    for (i = 1; i <= N; i++)
    {
        P = 1;
        for (k = 1; k <= i; k++)
        {
            P *= (double)k / i;
        }
        S += (1 + P) / (i * i);
    }
    cout << "for (++):   " << S << endl;

    // 4 спосіб: for з декрементом
    S = 0;
    for (i = N; i >= 1; i--)
    {
        P = 1;
        for (k = i; k >= 1; k--)
        {
            P *= (double)k / i;
        }
        S += (1 + P) / (i * i);
    }
    cout << "for (--):   " << S << endl;

    return 0;
}
